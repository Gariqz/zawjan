{
  "name": "zawjan-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zawjan — production-intended React + TypeScript frontend (mock adapters) with derived Figma export",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "vite build --mode export --outDir dist-demo",
    "build:export": "vite build --mode export --outDir dist-export",
    "preview:export": "vite preview --mode export --outDir dist-export --port 4317 --strictPort",
    "export:figma": "npm run build:export && node scripts/export-figma.mjs",
    "export:validate": "node scripts/validate-export.mjs",
    "demo:check": "npm run build:export && node scripts/demo-walkthrough.mjs",
    "smoke:production": "npm run build && node scripts/smoke-production.mjs",
    "verify": "npm run typecheck && npm test && npm run smoke:production && npm run export:figma && npm run export:validate && node scripts/demo-walkthrough.mjs",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
